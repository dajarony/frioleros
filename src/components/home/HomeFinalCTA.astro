---
import ButtonLink from "@components/ui/ButtonLink.astro";
import { hasContactEmail } from "@content/site";
import { withBase } from "@lib/paths";
import "@styles/home.css";

const base = import.meta.env.BASE_URL;
---

<section class="home-final-cta">
  <div>
    <p class="eyebrow">Empresas · Profesionales · Entidades</p>
    <h2>
      {hasContactEmail
        ? "La primera oportunidad empieza con una conversación."
        : "Conoce cómo puedes abrir una puerta."}
    </h2>
    <p>
      {hasContactEmail
        ? "Si puedes ofrecer empleo, prácticas, una visita técnica, mentoría o formación, queremos escucharte."
        : "Si puedes ofrecer empleo, prácticas, mentoría o formación, conoce las formas de colaborar. El canal oficial de contacto está en preparación."}
    </p>
  </div>

  <div class="home-final-cta__actions">
    <ButtonLink href={withBase(base, "/empresas-oportunidades/")}>
      Ver formas de colaborar
    </ButtonLink>
    {hasContactEmail && (
      <ButtonLink href={withBase(base, "/contacto/")} variant="secondary">
        Contactar
      </ButtonLink>
    )}
  </div>
</section>
