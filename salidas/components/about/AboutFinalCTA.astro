import ButtonLink from "@components/ui/ButtonLink.astro";
import { withBase } from "@lib/paths";
import "@styles/about.css";

const base = import.meta.env.BASE_URL;
---

<section class="about-final-cta">
  <div>
    <p class="eyebrow">El objetivo es sencillo</p>
    <h2>Que alguien nos dé la oportunidad de demostrarlo.</h2>
    <p>
      Si eres una empresa o profesional del sector, queremos que puedas
      conocernos antes de decidir si existe una forma de colaborar.
    </p>
  </div>

  <ButtonLink href={withBase(base, "/empresas-oportunidades/")}>
    Ver oportunidades
  </ButtonLink>
</section>
