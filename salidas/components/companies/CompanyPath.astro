---
/*
SUME DOCBLOCK

Nombre: salidas/components/companies/CompanyPath.astro
Tipo: Salida

Entradas:
- propiedades y datos de contenido

Acciones:
- compone una sección de interfaz

Salidas:
- HTML accesible para la página
*/

import { companySteps } from "@content/companies";
import "@styles/companies.css";
---

<div class="company-path">
  {companySteps.map((item) => (
    <article class="company-path__step">
      <span>{item.step}</span>
      <div>
        <h3>{item.title}</h3>
        <p>{item.description}</p>
      </div>
    </article>
  ))}
</div>
