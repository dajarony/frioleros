---
import { storySteps } from "@content/about";
import "@styles/about.css";
---

<div class="about-story">
  {storySteps.map((item) => (
    <article class="about-story__step">
      <span>{item.step}</span>
      <div>
        <h3>{item.title}</h3>
        <p>{item.description}</p>
      </div>
    </article>
  ))}
</div>
