---
import ButtonLink from "@components/ui/ButtonLink.astro";
import BrandLogo from "@components/brand/BrandLogo.astro";
import { withBase } from "@lib/paths";

const base = import.meta.env.BASE_URL;
---

<section class="hero">
  <div class="hero__ice hero__ice--one" aria-hidden="true"></div>
  <div class="hero__ice hero__ice--two" aria-hidden="true"></div>

  <div class="shell hero__grid">
    <div class="hero__copy">
      <p class="eyebrow">Refrigeración industrial · Canarias</p>

      <h1>
        El talento que
        <span>enfría el futuro.</span>
      </h1>

      <p class="hero__lead">
        Somos estudiantes de refrigeración industrial que buscamos empresas
        dispuestas a darnos una primera oportunidad para aprender, trabajar
        y crecer dentro del sector del frío.
      </p>

      <div class="hero__actions">
        <ButtonLink href={withBase(base, "/equipo/")}>Conoce al equipo</ButtonLink>
        <ButtonLink href={withBase(base, "/empresas-oportunidades/")} variant="secondary">
          Ofrece una oportunidad
        </ButtonLink>
      </div>

      <p class="hero__microcopy">
        Empleo · Prácticas · Mentoría · Visitas técnicas · Formación
      </p>
    </div>

    <div class="hero__brand-visual">
      <BrandLogo mode="hero" />
      <p>Entrar · Aprender · Crecer</p>
    </div>
  </div>
</section>

<style>
  .hero__brand-visual {
    position: relative;
    z-index: 2;
    display: grid;
    place-items: center;
  }

  .hero__brand-visual > p {
    margin: -1.2rem 0 0;
    color: #b9d7e9;
    font-family: "Barlow Condensed", sans-serif;
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-align: center;
    text-transform: uppercase;
  }

  @media (max-width: 1040px) {
    .hero__brand-visual {
      width: min(100%, 600px);
      justify-self: center;
    }
  }
</style>
