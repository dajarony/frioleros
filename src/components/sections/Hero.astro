---
import ButtonLink from "@components/ui/ButtonLink.astro";
import { site } from "@content/site";

const base = import.meta.env.BASE_URL;
---

<section class="hero">
  <div class="shell hero__grid">
    <div class="hero__copy">
      <p class="eyebrow">Refrigeración industrial · Canarias</p>
      <h1>El talento que <span>enfría el futuro.</span></h1>
      <p class="hero__lead">
        Somos estudiantes que buscamos empresas dispuestas a darnos una oportunidad
        para aprender, trabajar y crecer dentro del sector del frío.
      </p>

      <div class="hero__actions">
        <ButtonLink href={`${base}equipo/`}>Conócenos</ButtonLink>
        <ButtonLink href={`${base}empresas-oportunidades/`} variant="secondary">
          Ofrece una oportunidad
        </ButtonLink>
      </div>
    </div>

    <aside class="hero__statement" aria-label="Mensaje Frioleros">
      <span>FRIOLEROS</span>
      <strong>{site.tagline}</strong>
      <p>Formación. Talento. Empleo. Industria.</p>
    </aside>
  </div>
</section>
