---
import { projects } from "@content/projects";
---

<div class="card-grid card-grid--three">
  {projects.map((project) => (
    <article class="project-card">
      <p class="project-card__category">{project.category}</p>
      <h3>{project.title}</h3>
      <p>{project.description}</p>
    </article>
  ))}
</div>
