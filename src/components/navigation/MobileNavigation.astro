---
import { navigation } from "@content/site";
import { isCurrentPath, withBase } from "@lib/paths";

const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
---

<details class="mobile-nav">
  <summary aria-label="Abrir navegación">
    <span></span>
    <span></span>
    <span></span>
  </summary>

  <nav aria-label="Navegación móvil">
    <ul>
      {navigation.map((item) => (
        <li>
          <a
            href={withBase(base, item.href)}
            aria-current={isCurrentPath(currentPath, base, item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <a class="mobile-nav__cta" href={withBase(base, "/empresas-oportunidades/")}>
      Ofrece una oportunidad
    </a>
  </nav>
</details>
