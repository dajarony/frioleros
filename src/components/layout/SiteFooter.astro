---
import BrandLogo from "@components/brand/BrandLogo.astro";
import { navigation, site } from "@content/site";
import { withBase } from "@lib/paths";
import "@styles/footer.css";

const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell site-footer__main">
    <div class="site-footer__identity">
      <BrandLogo />
      <p>
        Estudiantes de refrigeración industrial en Canarias conectando
        formación, talento y oportunidades reales.
      </p>
    </div>

    <nav aria-label="Navegación secundaria">
      <p class="site-footer__heading">Explorar</p>
      <ul>
        {navigation.map((item) => (
          <li>
            <a href={withBase(base, item.href)}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-footer__action">
      <strong>¿Puedes abrir una puerta?</strong>
      <p>
        Empleo, prácticas, mentoría, visitas técnicas, formación o colaboración.
      </p>
      <a href={withBase(base, "/empresas-oportunidades/")}>
        Ver formas de colaborar →
      </a>
    </div>
  </div>

  <div class="shell site-footer__bottom">
    <p>© {year} Frioleros · {site.location}</p>
    <p>El talento que enfría el futuro.</p>
  </div>
</footer>
