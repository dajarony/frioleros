---
import BaseLayout from "@layouts/BaseLayout.astro";
import ButtonLink from "@components/ui/ButtonLink.astro";
import { withBase } from "@lib/paths";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Página no encontrada"
  description="La página que buscas no existe o ha cambiado de dirección."
  noindex
>
  <section class="not-found">
    <div class="shell not-found__inner">
      <p class="not-found__code">404</p>
      <p class="eyebrow">Página no encontrada</p>
      <h1>Esta ruta se quedó <span>sin frío.</span></h1>
      <p class="not-found__text">
        La página que buscas no existe o ha cambiado de dirección. Puedes
        volver al inicio o explorar el equipo de Frioleros.
      </p>

      <div class="not-found__actions">
        <ButtonLink href={base}>Volver al inicio</ButtonLink>
        <ButtonLink href={withBase(base, "/equipo/")} variant="secondary">
          Ver equipo
        </ButtonLink>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    min-height: 70vh;
    place-items: center;
    padding-block: 5rem;
    background:
      radial-gradient(circle at 78% 28%, rgba(43, 193, 255, 0.15), transparent 26rem),
      var(--bg);
  }

  .not-found__inner { position: relative; }

  .not-found__code {
    margin-bottom: -2rem;
    color: rgba(43, 193, 255, 0.09);
    font-family: "Barlow Condensed", sans-serif;
    font-size: clamp(8rem, 24vw, 18rem);
    font-weight: 800;
    line-height: 0.7;
  }

  .not-found__text {
    max-width: 650px;
    color: var(--muted);
    line-height: 1.75;
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  @media (max-width: 620px) {
    .not-found__actions { flex-direction: column; }
  }
</style>
