---
import BaseLayout from "@layouts/BaseLayout.astro";
import StudentGrid from "@components/sections/StudentGrid.astro";
import SectionHeading from "@components/ui/SectionHeading.astro";
import { publishedStudents } from "@content/students";
---

<BaseLayout
  title="Equipo"
  description={publishedStudents.length > 0
    ? "Conoce los perfiles profesionales de los integrantes de Frioleros y las áreas del sector del frío en las que quieren desarrollarse."
    : "Frioleros prepara perfiles profesionales de sus integrantes. Consulta el formato de muestra mientras se autorizan los perfiles reales."}
>
  <section class="page-hero">
    <div class="shell">
      <p class="eyebrow">Nuestro equipo</p>
      <h1>Personas diferentes. <span>Un mismo objetivo.</span></h1>
      <p>
        Cada integrante tendrá un perfil profesional sencillo para que una
        empresa pueda entender rápidamente quién es, qué está aprendiendo y
        hacia dónde quiere crecer.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionHeading
        eyebrow="Talento en formación"
        title={publishedStudents.length > 0 ? "Conoce al equipo" : "Así serán los perfiles"}
        text={publishedStudents.length > 0
          ? "Cada perfil muestra información profesional confirmada por su integrante."
          : "Por ahora mostramos una ficha de demostración. Los perfiles reales se publicarán solo con la autorización de cada integrante."}
      />
      <StudentGrid />
    </div>
  </section>
</BaseLayout>
