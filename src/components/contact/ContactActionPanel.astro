---
import ButtonLink from "@components/ui/ButtonLink.astro";
import { contactEmail, hasContactEmail } from "@content/contact-channel";
import "@styles/contact.css";

const subject = encodeURIComponent("Oportunidad / colaboración con Frioleros");
const body = encodeURIComponent(
  [
    "Hola equipo de Frioleros,",
    "",
    "Nombre / empresa:",
    "Isla o municipio:",
    "Tipo de oportunidad:",
    "Descripción:",
    "Persona de contacto:",
    "",
    "Gracias.",
  ].join("\n"),
);

const mailto = hasContactEmail
  ? `mailto:${contactEmail}?subject=${subject}&body=${body}`
  : "";
---

<section class="contact-action-panel" aria-labelledby="contact-action-title">
  <div>
    <p class="eyebrow">Canal directo</p>
    <h2 id="contact-action-title">
      {hasContactEmail ? "Hablemos de una oportunidad real." : "Canal de contacto en preparación."}
    </h2>
    <p>
      {hasContactEmail
        ? "Cuéntanos qué oportunidad propones y desde qué isla nos escribes. Puedes usar el mensaje preparado o copiar el correo del proyecto."
        : "El grupo está definiendo su correo oficial. Publicaremos aquí el canal de contacto en cuanto esté confirmado."}
    </p>
  </div>

  <div class="contact-action-panel__action">
    {hasContactEmail ? (
      <>
        <ButtonLink href={mailto}>Escribir a Frioleros</ButtonLink>
        <a class="contact-action-panel__email" href={`mailto:${contactEmail}`}>
          {contactEmail}
        </a>
      </>
    ) : (
      <>
        <strong>Canal oficial en preparación</strong>
        <p>Aún no podemos recibir propuestas desde esta web.</p>
      </>
    )}
  </div>
</section>
