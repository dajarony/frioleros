---
/*
SUME DOCBLOCK

Nombre: src/pages/equipo/[id].astro
Tipo: Entrada

Entradas:
- URL y parámetros de ruta

Acciones:
- compone la salida de la ruta Astro

Salidas:
- página HTML o sitemap XML
*/

import StudentProfile from "@components/students/StudentProfile.astro";
import { students } from "@content/students";
import BaseLayout from "@layouts/BaseLayout.astro";
import type { Student } from "@domain/student";

export function getStaticPaths() {
  return students.map((student) => ({
    params: { id: student.id },
    props: { student },
  }));
}

interface Props {
  student: Student;
}

const { student } = Astro.props;
---

<BaseLayout
  title={student.name}
  description={student.summary}
  noindex={student.status === "demo"}
>
  <StudentProfile student={student} />
</BaseLayout>
