---
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/sections/Hero.astro";
import ImpactStrip from "@components/sections/ImpactStrip.astro";
import OpportunityGrid from "@components/sections/OpportunityGrid.astro";
import CompanyCallout from "@components/sections/CompanyCallout.astro";
import SectionHeading from "@components/ui/SectionHeading.astro";
---

<BaseLayout>
  <Hero />
  <ImpactStrip />

  <section class="section section--light">
    <div class="shell">
      <SectionHeading
        eyebrow="Qué puede aportar una empresa"
        title="Varias puertas. Un mismo objetivo."
        text="Frioleros convierte la formación en un punto de encuentro entre estudiantes y empresas que quieran apostar por nuevo talento."
      />
      <OpportunityGrid />
    </div>
  </section>

  <CompanyCallout />
</BaseLayout>
