---
import BrandLogo from "@components/brand/BrandLogo.astro";
import ButtonLink from "@components/ui/ButtonLink.astro";
import { publishedStudents } from "@content/students";
import { withBase } from "@lib/paths";
import "@styles/about.css";

const base = import.meta.env.BASE_URL;
---

<section class="about-identity">
  <div class="about-identity__brand">
    <BrandLogo mode="hero" />
  </div>

  <div class="about-identity__copy">
    <p class="eyebrow">Qué es Frioleros</p>
    <h2>Una identidad para abrir puertas.</h2>
    <p>
      Frioleros es el escaparate profesional del grupo: un lugar donde una
      empresa puede conocernos, entender qué estamos aprendiendo y descubrir
      a las personas que quieren desarrollarse dentro del sector del frío.
    </p>
    <p>
      La web no pretende convertirnos en expertos antes de tiempo. Pretende
      hacer visible el esfuerzo, la formación y las ganas de conseguir una
      primera oportunidad real.
    </p>

    <div class="about-identity__actions">
      <ButtonLink href={withBase(base, "/equipo/")}>
        {publishedStudents.length > 0 ? "Conoce al equipo" : "Ver perfil de muestra"}
      </ButtonLink>
      <ButtonLink href={withBase(base, "/formacion-proyectos/")} variant="secondary">
        Ver formación
      </ButtonLink>
    </div>
  </div>
</section>
