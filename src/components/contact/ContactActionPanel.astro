---
import ButtonLink from "@components/ui/ButtonLink.astro";
import { site } from "@content/site";
import "@styles/contact.css";

const subject = encodeURIComponent("Oportunidad / colaboración con Frioleros");
const body = encodeURIComponent(
  [
    "Hola equipo de Frioleros,",
    "",
    "Nombre / empresa:",
    "Isla o municipio:",
    "Tipo de oportunidad:",
    "Descripción:",
    "Persona de contacto:",
    "",
    "Gracias.",
  ].join("\n"),
);

const mailto = site.contactEmail
  ? `mailto:${site.contactEmail}?subject=${subject}&body=${body}`
  : "";
---

<section class="contact-action-panel" aria-labelledby="contact-action-title">
  <div>
    <p class="eyebrow">Canal directo</p>
    <h2 id="contact-action-title">Hablemos de una oportunidad real.</h2>
    <p>
      Queremos que contactar con Frioleros sea sencillo. El canal oficial del
      proyecto se publicará aquí en cuanto quede definido por el grupo.
    </p>
  </div>

  <div class="contact-action-panel__action">
    {site.contactEmail ? (
      <>
        <ButtonLink href={mailto}>Escribir a Frioleros</ButtonLink>
        <a class="contact-action-panel__email" href={`mailto:${site.contactEmail}`}>
          {site.contactEmail}
        </a>
      </>
    ) : (
      <>
        <strong>Canal oficial en preparación</strong>
        <p>
          La página está lista para activarlo sin tocar el diseño ni la
          arquitectura: solo necesitamos definir el correo oficial del proyecto.
        </p>
      </>
    )}
  </div>
</section>
