---
import BrandLogo from "@components/brand/BrandLogo.astro";
import MobileNavigation from "@components/navigation/MobileNavigation.astro";
import { hasContactEmail, navigation, site } from "@content/site";
import { isCurrentPath, withBase } from "@lib/paths";
import "@styles/header.css";

const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="brand" href={base} aria-label={`${site.name}, inicio`}>
      <BrandLogo />
    </a>

    <nav class="desktop-nav" aria-label="Navegación principal">
      <ul class="nav-list">
        {navigation.map((item) => (
          <li>
            <a
              href={withBase(base, item.href)}
              aria-current={isCurrentPath(currentPath, base, item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a class="header-cta" href={withBase(base, "/empresas-oportunidades/")}>
      {hasContactEmail ? "Ofrece una oportunidad" : "Formas de colaborar"}
    </a>

    <MobileNavigation />
  </div>
</header>
