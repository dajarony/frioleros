---
/*
SUME DOCBLOCK

Nombre: salidas/components/about/AboutPrinciples.astro
Tipo: Salida

Entradas:
- propiedades y datos de contenido

Acciones:
- compone una sección de interfaz

Salidas:
- HTML accesible para la página
*/

import { projectPrinciples } from "@content/about";
import "@styles/about.css";
---

<div class="about-principles">
  {projectPrinciples.map((principle, index) => (
    <article class="about-principle">
      <span>{String(index + 1).padStart(2, "0")}</span>
      <h3>{principle.title}</h3>
      <p>{principle.description}</p>
    </article>
  ))}
</div>
