---
import { navigation } from "@content/site";
import { isCurrentPath, withBase } from "@lib/paths";

const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
---

<details class="mobile-nav">
  <summary aria-label="Abrir menú de navegación">
    <span class="mobile-nav__icon" aria-hidden="true">
      <i></i>
      <i></i>
      <i></i>
    </span>
    <span class="mobile-nav__label">Menú</span>
  </summary>

  <nav aria-label="Navegación móvil">
    <ul>
      {navigation.map((item) => (
        <li>
          <a
            href={withBase(base, item.href)}
            aria-current={isCurrentPath(currentPath, base, item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <a class="mobile-nav__cta" href={withBase(base, "/empresas-oportunidades/")}>
      Ofrece una oportunidad
    </a>
  </nav>
</details>

<style>
  .mobile-nav summary {
    width: auto;
    min-width: 76px;
    grid-auto-flow: column;
    align-items: center;
    padding-inline: 0.65rem;
  }

  .mobile-nav__icon {
    display: grid;
    gap: 3px;
  }

  .mobile-nav__icon i {
    display: block;
    width: 16px;
    height: 2px;
    background: currentColor;
  }

  .mobile-nav__label {
    color: #cbe0ed;
    font-size: 0.67rem;
    font-style: normal;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .mobile-nav[open] summary {
    border-color: var(--ice);
    color: var(--ice);
  }
</style>
