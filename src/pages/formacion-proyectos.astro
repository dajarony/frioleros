---
import BaseLayout from "@layouts/BaseLayout.astro";
import ProjectGrid from "@components/sections/ProjectGrid.astro";
import SectionHeading from "@components/ui/SectionHeading.astro";
---

<BaseLayout title="Formación y proyectos">
  <section class="page-hero">
    <div class="shell">
      <p class="eyebrow">De la formación a la industria</p>
      <h1>Aprender haciendo. <span>Crecer demostrando.</span></h1>
      <p>Mostramos competencias y trabajos reales, no porcentajes inventados.</p>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionHeading title="Lo que estamos aprendiendo" />
      <ProjectGrid />
    </div>
  </section>
</BaseLayout>
